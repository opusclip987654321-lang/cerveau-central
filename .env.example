# Copier en .env sur le serveur (jamais sur GitHub) puis remplir.

# Bot Telegram qui envoie les alertes (le bot du récap hebdo) et la conversation où les recevoir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facultatif : lecture des exécutions en erreur de n8n (Settings > n8n API dans n8n).
N8N_URL=https://n8n.nourmeet.com
N8N_API_KEY=

# Fréquence des vérifications, en minutes (180 = toutes les 3 h).
INTERVALLE_MINUTES=180

# Mot de passe de la page : lancer `docker compose run --rm cerveau node src/mot-de-passe.js`
# et coller ici la ligne qu'il affiche (c'est une empreinte, pas le mot de passe).
MOT_DE_PASSE_EMPREINTE=

# Réseau Docker de Caddy (voir README, « Ouvrir la page depuis ton Mac »).
RESEAU_CADDY=nour-meet_default

# Page d'état : adresse d'écoute dans le conteneur.
HOTE=127.0.0.1
PORT=8090

# Heure (heure de Paris) du résumé Telegram du matin (état + questions du jour).
RESUME_HEURE=9

# Copier en .env sur le serveur (jamais sur GitHub) puis remplir.

# Bot Telegram qui envoie les alertes (le bot du récap hebdo) et la conversation où les recevoir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facultatif : lecture des exécutions en erreur de n8n (Settings > n8n API dans n8n).
N8N_URL=https://n8n.nourmeet.com
N8N_API_KEY=

# Fréquence des vérifications, en minutes (180 = toutes les 3 h).
INTERVALLE_MINUTES=180

# Mot de passe de la page : voir README (« Choisir le mot de passe »). La commande ajoute
# elle-même la ligne MOT_DE_PASSE_EMPREINTE=… (une empreinte, pas le mot de passe).

# Réseau Docker de Caddy (voir README, « Ouvrir la page depuis ton Mac »).
RESEAU_CADDY=nour-meet_default

# Page d'état : adresse d'écoute dans le conteneur.
HOTE=127.0.0.1
PORT=8090

# Heure (heure de Paris) du résumé Telegram du matin (état + questions du jour).
RESUME_HEURE=9

# Facultatif : clé API Claude (console.anthropic.com > API keys) pour lire les factures
# déposées dans l'onglet Argent, puis pour les conseils. Sans elle, les factures attendent.
ANTHROPIC_API_KEY=
# Plafond de dépense IA du cerveau par mois, en dollars : au-delà, il s'arrête et le dit.
PLAFOND_IA_DOLLARS=10

# Jeton des relevés de VPS (onglet Serveurs). Le créer avec : openssl rand -hex 24
# et mettre le même dans ~/.cerveau-releve sur chaque VPS (voir README).
RELEVE_JETON=

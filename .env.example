# Copier en .env sur le serveur (jamais sur GitHub) puis remplir.

# Bot Telegram qui envoie les alertes (le bot du récap hebdo) et la conversation où les recevoir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facultatif : lecture des exécutions en erreur de n8n (Settings > n8n API dans n8n).
N8N_URL=https://n8n.nourmeet.com
N8N_API_KEY=

# Fréquence des vérifications, en minutes.
INTERVALLE_MINUTES=15

# Page d'état : écoute seulement en local, ouverte depuis l'ordinateur de louis par tunnel SSH.
HOTE=127.0.0.1
PORT=8090
